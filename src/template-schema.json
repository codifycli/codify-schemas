{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "https://www.codifycli.com/template-schema.json",
  "title": "Template Schema",
  "description": "Includes the resources of a Codify template. The template's resources are merged into the plan at the position the template is declared.",
  "type": "object",
  "properties": {
    "type": {
      "description": "All template configs are of the type template",
      "type": "string",
      "const": "template"
    },
    "name": {
      "description": "Optional name. Required to reference the template in dependsOn when multiple templates are declared",
      "type": "string",
      "pattern": "^[\\w-]+$"
    },
    "source": {
      "description": "The template to include. Either a registry template name (\"nvm\"), a profile scoped registry template name (\"@codify/nvm\"), or a Codify dashboard document id (uuid)",
      "type": "string",
      "pattern": "^(@[\\w.-]+\\/)?[\\w.-]+$"
    },
    "version": {
      "description": "Exact semver version of the registry template. Defaults to the latest version",
      "type": "string",
      "pattern": "^([0-9]+)\\.([0-9]+)\\.([0-9]+)(?:-([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?(?:\\+[0-9A-Za-z-]+)?$"
    },
    "dependsOn": {
      "description": "Applied to every resource inside the template",
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "os": {
      "description": "Applied to every resource inside the template",
      "type": "array",
      "items": {
        "enum": [
          "linux",
          "macOS",
          "windows"
        ]
      },
      "uniqueItems": true
    },
    "distro": {
      "description": "Applied to every resource inside the template",
      "type": "array",
      "items": {
        "enum": [
          "debian-based",
          "rpm-based",
          "arch",
          "centos",
          "debian",
          "fedora",
          "rhel",
          "ubuntu",
          "alpine",
          "amzn",
          "opensuse",
          "sles",
          "manjaro",
          "linuxmint",
          "pop",
          "elementary",
          "kali",
          "gentoo",
          "slackware"
        ]
      },
      "uniqueItems": true
    },
    "when": {
      "description": "Only include the template if the condition matches. Keys are variable names and every key must match. Use \"any\" for alternatives",
      "type": "object",
      "properties": {
        "any": {
          "description": "At least one of the conditions must match",
          "type": "array",
          "items": {
            "type": "object",
            "patternProperties": {
              "^(?!any$)[\\w-]+$": {
                "description": "A value: the variable must equal it (multiEnum variables: must include it). A list: the variable must equal one of the values (multiEnum variables: must include one of them). {\"not\": value or list}: the opposite.",
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "boolean"
                        }
                      ]
                    },
                    "minItems": 1
                  },
                  {
                    "type": "object",
                    "properties": {
                      "not": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "boolean"
                          },
                          {
                            "type": "array",
                            "items": {
                              "anyOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "number"
                                },
                                {
                                  "type": "boolean"
                                }
                              ]
                            },
                            "minItems": 1
                          }
                        ]
                      }
                    },
                    "required": [
                      "not"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "additionalProperties": false,
            "minProperties": 1
          },
          "minItems": 1
        }
      },
      "patternProperties": {
        "^(?!any$)[\\w-]+$": {
          "description": "A value: the variable must equal it (multiEnum variables: must include it). A list: the variable must equal one of the values (multiEnum variables: must include one of them). {\"not\": value or list}: the opposite.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              },
              "minItems": 1
            },
            {
              "type": "object",
              "properties": {
                "not": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "boolean"
                          }
                        ]
                      },
                      "minItems": 1
                    }
                  ]
                }
              },
              "required": [
                "not"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "variables": {
      "description": "Values for the variables of the template. Can reference variables of this config: { \"projectName\": \"${{ projectName }}\" }. Variables of the template that are not set here are asked when running",
      "type": "object",
      "patternProperties": {
        "^[\\w-]+$": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "required": [
    "type",
    "source"
  ]
}
